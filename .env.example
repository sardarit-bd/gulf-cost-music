# Gulf Coast Music Frontend - Environment Variables Template
# Copy this file to .env.local or .env for local development

# Backend API Configuration
# Local Development: http://localhost:5001 or http://localhost:5000
# Production: https://api.gulfcoastmusic.live
NEXT_PUBLIC_BASE_URL=https://api.gulfcoastmusic.live

# Cloudinary Public Configuration
# Used for media delivery (images/videos) and unsigned client-side video uploads via widget/REST API
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your_cloudinary_upload_preset
